# ============================================
# Crawler Environment Variables
# ============================================
# IMPORTANT: This is a template. DO NOT commit actual secrets.
# Copy to .env and fill with actual values for local development.
# For production, use environment variable services.

# ============================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nigerian_directory
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# ============================================
# REDIS CONFIGURATION (OPTIONAL)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# CRAWLER CONFIGURATION
# ============================================
CRAWLER_USER_AGENT=NigerianDirectory Bot/1.0 (+https://nigeriandirectory.com/bot)
CRAWLER_DELAY=2
CRAWLER_MAX_RETRIES=3

# ============================================
# AI/ENRICHMENT CONFIGURATION
# ============================================
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# LOGGING (OPTIONAL)
# ============================================
LOG_LEVEL=info
