# ============================================
# NigerianDirectory Environment Variables
# ============================================
# IMPORTANT: This is a template. DO NOT commit actual secrets to this file.
# Use GitHub Actions secrets or environment variable services for production.
# See ENVIRONMENT_SETUP.md for detailed configuration instructions.

# ============================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================
# PostgreSQL connection settings
# Production: Use managed database service (AWS RDS, DigitalOcean, Railway)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nigerian_directory
DB_USER=postgres
DB_PASSWORD=your_secure_password_here_do_not_hardcode

# ============================================
# REDIS CONFIGURATION (OPTIONAL)
# ============================================
# Redis connection settings
# For development: local Redis instance
# For production: Use managed Redis (AWS ElastiCache, Redis Cloud)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_if_required

# ============================================
# BACKEND CONFIGURATION (REQUIRED)
# ============================================
PORT=5000
NODE_ENV=development
# Values: development, staging, production
# WARNING: Set to 'production' for all production deployments

# ============================================
# AUTHENTICATION (REQUIRED - GENERATE SECURE VALUES)
# ============================================
# JWT Secret: Use a cryptographically secure random string (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_secure_jwt_secret_minimum_32_chars
JWT_EXPIRES_IN=7d

# Token Configuration (OPTIONAL - defaults provided)
# Access token: Short-lived (~15 minutes), used for API requests
ACCESS_TOKEN_EXPIRES_IN=15m

# Refresh token: Long-lived (~7 days), used to obtain new access tokens
REFRESH_TOKEN_EXPIRES_IN=7d

# Admin Setup (Used during initial deployment only)
# ADMIN_EMAIL and ADMIN_PASSWORD are used in setup script to create initial admin
# They should be removed after initial deployment
ADMIN_EMAIL=admin@nigeriandirectory.com
ADMIN_PASSWORD=your_secure_temporary_admin_password

# ============================================
# FRONTEND CONFIGURATION (REQUIRED)
# ============================================
# Backend API URL for frontend requests
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Frontend site URL (used for CORS and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================
# EXTERNAL APIS
# ============================================
# Google Maps API - Get from: https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenAI API (for content enrichment) - Get from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# CRAWLER CONFIGURATION
# ============================================
CRAWLER_USER_AGENT=NigerianDirectory Bot/1.0 (+https://nigeriandirectory.com/bot)
CRAWLER_DELAY=2
CRAWLER_MAX_RETRIES=3

# ============================================
# PAYMENT INTEGRATION (FUTURE)
# ============================================
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# ============================================
# EMAIL CONFIGURATION (FUTURE)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# ============================================
# ADVERTISING - Google AdSense & Media.net
# ============================================
# Google AdSense - Get your ID from: https://www.google.com/adsense
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# Media.net - Get your IDs from: https://www.media.net
NEXT_PUBLIC_MEDIANET_CUSTOMER_ID=8CUXXXXXXX
NEXT_PUBLIC_MEDIANET_WINDOW_ID=8CUXXXXXXX

# ============================================
# ERROR TRACKING (PRODUCTION RECOMMENDED)
# ============================================
# Sentry DSN for error tracking - Get from: https://sentry.io/
SENTRY_DSN=your_sentry_dsn_url
SENTRY_ENVIRONMENT=production

# ============================================
# LOGGING (OPTIONAL)
# ============================================
# LOG_LEVEL: error, warn, info, debug
LOG_LEVEL=info
