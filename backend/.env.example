# ============================================
# Backend Environment Variables
# ============================================
# IMPORTANT: This is a template. DO NOT commit actual secrets.
# Copy to .env and fill with actual values for local development.
# For production, use GitHub Actions secrets and environment variable services.

# ============================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nigerian_directory
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Alternatively, one connection string (as Neon provides). When set it takes
# precedence over the DB_* variables above.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ============================================
# REDIS CONFIGURATION (OPTIONAL)
# ============================================
# Leave REDIS_URL and REDIS_HOST unset to use a per-process in-memory cache
# (what the Vercel deployment does). The admin crawl queue needs a real Redis
# shared with the Python crawler and returns 503 without one.
# REDIS_URL=redis://:password@host:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# RATE LIMITING & PROXY (OPTIONAL)
# ============================================
# How many proxies sit in front of the API, so the client IP used for rate
# limits is read correctly. Defaults to 1 on Vercel and off elsewhere. Set to
# 1 behind nginx. Never set it when nothing is in front: clients could then
# spoof X-Forwarded-For.
# TRUST_PROXY=1
# Requests per IP per 15 minutes on /api (default 100).
# RATE_LIMIT_MAX=100
# Shared secret the frontend sends on server-side requests so page builds are
# not rate limited. Set the same value as INTERNAL_API_KEY in the frontend.
# Generate with: openssl rand -hex 32
# INTERNAL_API_KEY=

# ============================================
# SERVER CONFIGURATION (REQUIRED)
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# AUTHENTICATION (REQUIRED)
# ============================================
# Generate JWT secret with: openssl rand -base64 32
JWT_SECRET=your_secure_jwt_secret_minimum_32_chars
JWT_EXPIRES_IN=7d
# Optional: separate key for signing CSRF tokens (derived from JWT_SECRET if unset)
# CSRF_SECRET=

# Token expiration times (OPTIONAL - defaults provided)
# Access token: Short-lived, used for API requests (default: 15m)
ACCESS_TOKEN_EXPIRES_IN=15m

# Refresh token: Long-lived, used to obtain new access tokens (default: 7d)
REFRESH_TOKEN_EXPIRES_IN=7d

# ============================================
# ADMIN CONFIGURATION (Initial Setup Only)
# ============================================
ADMIN_EMAIL=admin@nigeriandirectory.com
ADMIN_PASSWORD=your_secure_temporary_admin_password

# ============================================
# FRONTEND CONFIGURATION (REQUIRED)
# ============================================
FRONTEND_URL=http://localhost:3000

# ============================================
# LOGGING (OPTIONAL)
# ============================================
LOG_LEVEL=info

# ============================================
# ERROR TRACKING (OPTIONAL)
# ============================================
SENTRY_DSN=
