{
  "name": "nigerian-directory-backend",
  "version": "1.0.0",
  "description": "Backend API for NigerianDirectory.com - Schools directory platform",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "seed:locations": "node src/seeds/seedLocations.js",
    "seed:schools": "node src/seeds/seedSchools.js",
    "migrate": "node src/database/migrate.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
