# Frontend Environment Variables Template
# Copy this to .env.local and .env.production, then fill in actual values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5001/api
API_INTERNAL_URL=http://localhost:5001/api
# Server-side only (never NEXT_PUBLIC_). Must equal the backend's
# INTERNAL_API_KEY; lets server-rendered pages skip the API's per-IP rate limit.
INTERNAL_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics & Search Console
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-6RP3Q0FM2N
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code-here
