# ============================================
# Frontend Environment Variables
# ============================================
# IMPORTANT: This is a template. DO NOT commit actual secrets.
# For local development, copy to .env.local and fill with values.
# For production, build-time variables are injected via GitHub Actions.

# ============================================
# API CONFIGURATION (REQUIRED)
# ============================================
# Backend API URL for frontend requests
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Frontend site URL (used in meta tags and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================
# EXTERNAL APIS
# ============================================
# Google Maps API - Get from: https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ============================================
# ADVERTISING - Google AdSense & Media.net
# ============================================
# Google AdSense - Get your ID from: https://www.google.com/adsense
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# Media.net - Get your IDs from: https://www.media.net
NEXT_PUBLIC_MEDIANET_CUSTOMER_ID=8CUXXXXXXX
NEXT_PUBLIC_MEDIANET_WINDOW_ID=8CUXXXXXXX

# ============================================
# ANALYTICS & TRACKING (OPTIONAL)
# ============================================
# Google Analytics measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ============================================
# FEATURE FLAGS (OPTIONAL)
# ============================================
# Enable/disable features in production
NEXT_PUBLIC_ENABLE_CLAIMS=true
NEXT_PUBLIC_ENABLE_ENRICHMENT=true
